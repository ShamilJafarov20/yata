<UserControl x:Class="Yata.Views.ClipboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:y="clr-namespace:Yata">
    <Grid Margin="{StaticResource PageInsetFilled}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="8,0,0,4">
            <TextBlock x:Name="HintText" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"
                       Text="{x:Static y:Strings.Clip_Hint}"/>
            <Button x:Name="ClearButton" Style="{StaticResource PillButton}" HorizontalAlignment="Right"
                    Content="{x:Static y:Strings.Clip_Clear}" Click="OnClear"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="List"/>
        </ScrollViewer>

        <!-- Off, or nothing copied yet -->
        <StackPanel x:Name="EmptyPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="EmptyText" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                       Foreground="{DynamicResource TextSecondary}"/>
            <Button x:Name="TurnOnButton" Style="{StaticResource PillButton}" HorizontalAlignment="Center" Margin="0,8,0,0"
                    Content="{x:Static y:Strings.Clip_TurnOn}" Click="OnTurnOn"/>
        </StackPanel>
    </Grid>
</UserControl>
