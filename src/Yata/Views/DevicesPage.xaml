<UserControl x:Class="Yata.Views.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:y="clr-namespace:Yata">
    <Grid Margin="{StaticResource PageInset}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Calls: the microphone in Windows, and the call apps' sound -->
        <Grid Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="MicButton" Style="{StaticResource PillButton}" Height="36" Click="OnMicClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="MicGlyph" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Text="&#xE720;"/>
                    <TextBlock x:Name="MicText" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="DeafenButton" Grid.Column="2" Style="{StaticResource PillButton}" Height="36" Click="OnDeafenClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="DeafenGlyph" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Text="&#xE7F6;"/>
                    <TextBlock x:Name="DeafenText" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Bluetooth devices that report a battery -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="{x:Static y:Strings.Devices_Batteries}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
            <StackPanel x:Name="BatteryList" Margin="0,4,0,0"/>
            <TextBlock x:Name="NoBatteries" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap" Text="{x:Static y:Strings.Devices_NoBatteries}"/>
        </StackPanel>

        <!-- Network: Wi-Fi now, and a speed test on demand -->
        <Border Grid.Row="2" Height="1" VerticalAlignment="Top" Background="{DynamicResource DividerBrush}"/>
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="WifiText" FontSize="13" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SpeedText" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextSecondary}"
                           TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/>
            </StackPanel>
            <Button x:Name="SpeedButton" Grid.Column="1" Style="{StaticResource PillButton}" VerticalAlignment="Center"
                    Content="{x:Static y:Strings.Devices_TestSpeed}" Click="OnSpeedClick"/>
        </Grid>
    </Grid>
</UserControl>
